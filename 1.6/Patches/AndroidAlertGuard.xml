<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Prompt threat response for an overseen android in a fighting work mode. Placed ahead of the
	     configurable hostility response (which is muted for these androids, see MechOversight_Patches) in the
	     constant think tree, which is polled every 30 ticks and can interrupt the current job. -->
	<Operation Class="PatchOperationInsert" MayRequire="Ludeon.RimWorld.Biotech">
		<xpath>/Defs/ThinkTreeDef[defName="HumanlikeConstant"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow"]/subNodes/li[@Class="JobGiver_ConfigurableHostilityResponse"]</xpath>
		<order>Prepend</order>
		<value>
			<li Class="VREAndroidsOverhaul.ThinkNode_AndroidAlertGuard">
				<subNodes>
					<li Class="VREAndroidsOverhaul.ThinkNode_ConditionalAndroidWorkMode">
						<workMode>Escort</workMode>
						<subNodes>
							<li Class="VREAndroidsOverhaul.JobGiver_AndroidDefendOverseer" />
						</subNodes>
					</li>
					<li Class="VREAndroidsOverhaul.ThinkNode_AndroidBorrowedWorkModes">
						<combatOnly>true</combatOnly>
					</li>
				</subNodes>
			</li>
		</value>
	</Operation>

</Patch>
