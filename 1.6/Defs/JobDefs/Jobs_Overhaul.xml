<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Charging at an android stand. Not casually interruptible: an android that broke off work because
	     its battery was nearly flat should finish topping up rather than wander off again. -->
	<JobDef>
		<defName>VREA_ChargeAndroid</defName>
		<driverClass>VREAndroidsOverhaul.JobDriver_ChargeAndroid</driverClass>
		<reportString>charging at TargetA.</reportString>
		<casualInterruptible>false</casualInterruptible>
	</JobDef>

	<JobDef>
		<defName>VREA_ExtractSubcore</defName>
		<driverClass>VREAndroidsOverhaul.JobDriver_ExtractSubcore</driverClass>
		<reportString>extracting subcore from TargetA.</reportString>
	</JobDef>

	<WorkGiverDef>
		<defName>VREA_ExtractSubcore</defName>
		<label>extract android subcore</label>
		<giverClass>VREAndroidsOverhaul.WorkGiver_ExtractSubcore</giverClass>
		<workType>Crafting</workType>
		<verb>extract subcore from</verb>
		<gerund>extracting subcore from</gerund>
		<priorityInType>210</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
	</WorkGiverDef>

</Defs>
